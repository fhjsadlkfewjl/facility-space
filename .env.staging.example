# Generate actual values on VPS: bash scripts/staging-env.sh
POSTGRES_DB=facility_staging
POSTGRES_USER=facility
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DEMO_TOKEN=REPLACE_WITH_RANDOM_DEMO_TOKEN
PUBLIC_ADDRESS=:80
# Fixed in compose: NODE_ENV=staging, AUTH_MODE=demo, API PORT=3001.
# This preserves the existing prohibition of demo auth in production.
IMAGE_TAG=current
# Public HTTP/HTTPS; do not change this to publish database or API ports.
HTTP_BIND=127.0.0.1

# PRIVATE until HTTPS: set PUBLIC_ADDRESS=https://your-domain and HTTP_BIND=0.0.0.0 together.
# API uses original local-reviewer demo employee; no identity conversion.

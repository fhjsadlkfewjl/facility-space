# Local pilot only. Demo auth is forbidden with NODE_ENV=production.
NODE_ENV=development
AUTH_MODE=demo
DEMO_TOKEN=local-demo-token-only
VITE_DEMO_TOKEN=local-demo-token-only
POSTGRES_PASSWORD=local-postgres-change-me
DATABASE_URL=postgres://office:local-postgres-change-me@127.0.0.1:5432/office
SEED_DEMO=true
RUN_MIGRATIONS=true
# Production: AUTH_MODE=oidc, NODE_ENV=production, SEED_DEMO=false,
# VITE_DEMO_TOKEN empty, obtain approved gateway claims from IT.
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=

# Separate external staging: use .env.staging.example and compose.staging.yaml.
# Never upload this local environment or private-pilot-db.

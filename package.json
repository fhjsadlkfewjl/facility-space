{
  "name": "facility-management",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev -w @office/web\"",
    "build": "tsc --noEmit && npm run build -w @office/web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "import": "node --env-file-if-exists=.env --import tsx scripts/import.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "format": "prettier --write apps packages scripts tests playwright.config.ts",
    "import:local": "node --import tsx scripts/local-import.ts",
    "local": "node --import tsx scripts/local.ts",
    "assets:prepare": "python3 scripts/prepare-assets.py",
    "editor:plan": "node scripts/editor-requests.mjs",
    "test:python": "python3 tests/extract_test.py && python3 tests/test_har_editor.py && python3 tests/snapshot_test.py",
    "verify:local-import": "node --import tsx scripts/verify-local-import.ts",
    "test:source": "node scripts/test-source.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
